# Same policy as upstream (vendor/oh-my-pi/.gitattributes): text files are LF in the working tree on every
# platform, whatever core.autocrlf says. oxfmt (check:fmt) and byte-exact fixtures/golden files assume LF.
* text=auto eol=lf

*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.ico -text
*.woff -text
*.woff2 -text
*.ttf -text
*.otf -text
*.db -text
*.sqlite -text
