			"ts-morph": "^28.0.0",
			"typescript": "^7.0.2",
			"vite": "^8.1.4",
			"vite-plugin-solid": "^2.11.12"
		}
	},
	"scripts": {
		"postinstall": "bun scripts/link-natives.ts",
		"check:vendor": "bash scripts/check-vendor-tag.sh",
		"check": "bun run check:vendor && bun run lint && bun run check:fmt && bun run check:types",
		"check:types": "bun run --filter './packages/*' --sequential check:types && bun check --no-script -p tsconfig.json",
		"check:fmt": "oxfmt --check 'packages/*/{src,test,scripts}/**/*.{ts,tsx}' 'scripts/**/*.ts'",
		"lint": "oxlint packages scripts",
		"fmt": "oxfmt 'packages/*/{src,test,scripts}/**/*.{ts,tsx}' 'scripts/**/*.ts'",
		"test": "bun test --path-ignore-patterns '**/test/live/**' ./packages/protocol ./packages/daemon ./packages/web",
		"test:live": "bun test ./packages/daemon/test/live",
		"build": "bun run --filter '@omp-web/web' build",
		"start": "bun packages/daemon/src/index.ts",
		"sync:upstream": "bun scripts/sync-catalog.ts && bun install"
	},
	"devDependencies": {
		"@types/bun": "1.4.2",
		"oxfmt": "0.65.0",
		"oxlint": "1.85.0",
		"typescript": "7.0.2"
	},
	"packageManager": "bun@>=1.4.4",
	"engines": {
		"bun": ">=1.4.4"
	},
